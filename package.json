{
  "name": "pixel3d",
  "version": "0.2.57",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "seankealey",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit && svelte-check --workspace packages/web --tsconfig ./tsconfig.json --fail-on-warnings",
    "fixtures": "tsx packages/core/test/fixtures/make-fixtures.ts",
    "sample-3mf": "tsx packages/core/scripts/sample-3mf.ts",
    "build:cli": "esbuild packages/cli/src/main.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.base.json --external:manifold-3d --external:@jsquash/webp --banner:js=\"#!/usr/bin/env node\" --outfile=packages/cli/dist/px3d.mjs --metafile=packages/cli/dist/meta.json && tsx scripts/third-party-licenses.ts cli packages/cli/dist/meta.json packages/cli/dist/THIRD_PARTY_LICENSES.txt",
    "dev:cli": "tsx --tsconfig packages/cli/tsconfig.json packages/cli/src/main.ts",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build:web": "vite build --config packages/web/vite.config.ts",
    "test:e2e": "playwright test -c packages/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "@types/omggif": "^1.0.5",
    "@types/three": "^0.186.0",
    "@types/upng-js": "^2.1.5",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "three": "^0.186.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@jsquash/webp": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jpeg-js": "^0.4.4",
    "manifold-3d": "^3.5.4",
    "omggif": "^1.0.10",
    "upng-js": "^2.1.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "px3d": "packages/cli/dist/px3d.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
